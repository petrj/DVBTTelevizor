{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/DVBTTelevizor.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/DVBTTelevizor.sln",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary;ForceNoAlign"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "--project",
                "${workspaceFolder}/DVBTTelevizor.sln"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "Build on Linux",
            "type": "shell",
            "command": "dotnet",
            "args": [
              "build",
              "${workspaceFolder}/DVBTTelevizor.MAUI/DVBTTelevizor.MAUI.csproj",
              "-c", "Debug",
              "-f", "net9.0-android35.0",
              "/p:AndroidSdkDirectory=/home/kirk/Android/Sdk/"
            ],
            "group": {
              "kind": "build"
            },
            "problemMatcher":  "$msCompile",
            "detail": "Build the MAUI app using dotnet CLI"
          }
    ]
}