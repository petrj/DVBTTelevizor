<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DVBTTelevizor.MAUI.ImgButton"
             xmlns:local="DVBTTelevizor.MAUI"
             x:Name="ImgBtn">

            <Grid
                   Margin="0,0,0,0"
                   Padding="0,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="50*" />
                    <ColumnDefinition Width="50*" />
                </Grid.ColumnDefinitions>

                <Image Grid.Row="0" Grid.Column="0" x:Name="BtnImage" Source="{Binding Img, Source={x:Reference ImgBtn}}" VerticalOptions="Center" HorizontalOptions="Start"  />

                <Label Grid.Row="0" Grid.Column="1" Text="{Binding Title, Source={x:Reference ImgBtn}}"
                        FontSize="{Binding TextFontSize, Source={x:Reference ImgBtn}}"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Start"
                        VerticalOptions="Center"/>

                <Label Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Title, Source={x:Reference ImgBtn}}"
                        FontSize="{Binding TextFontSize, Source={x:Reference ImgBtn}}"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Start"
                        VerticalOptions="Center"/>

        <Grid.GestureRecognizers>
            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" NumberOfTapsRequired="1" />
        </Grid.GestureRecognizers>
    </Grid>
</ContentView>
