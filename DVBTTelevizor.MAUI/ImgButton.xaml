<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DVBTTelevizor.MAUI.ImgButton"
             xmlns:local="DVBTTelevizor.MAUI"
             x:Name="ImgBtn">
    <Frame
            x:Name="mainFrame"
            BackgroundColor="{Binding ButtonColor, Source={x:Reference ImgBtn}}"
            Padding="0"
            CornerRadius="10"
            HasShadow="True">
        <StackLayout
            Orientation="Horizontal"
            HorizontalOptions="FillAndExpand"
            VerticalOptions="FillAndExpand"
            Spacing="10"
            Margin="5,0,0,5">
            <Image x:Name="BtnImage" Source="{Binding Img, Source={x:Reference ImgBtn}}" VerticalOptions="Center" HorizontalOptions="Start"  />
            <Label Text="{Binding Title, Source={x:Reference ImgBtn}}"
                FontSize="16"
                FontAttributes="Bold"
                HorizontalTextAlignment="Start"
                VerticalOptions="Center"/>
        </StackLayout>
        <Frame.GestureRecognizers>
            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped" NumberOfTapsRequired="1" />
        </Frame.GestureRecognizers>
    </Frame>
</ContentView>
