<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DVBTTelevizor.MAUI.ImgButton"
             x:Name="ImgBtn">
    <Frame
            x:Name="mainFrame"
            BackgroundColor="LightGray"
            Padding="10"
            CornerRadius="10"
            HasShadow="True">
        <StackLayout HorizontalOptions="Center" VerticalOptions="Center">
            <Image x:Name="BtnImage" Source="{Binding Img, Source={x:Reference ImgBtn}}"  WidthRequest="50" HeightRequest="50"  VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand"  />
            <Label Text="{Binding Title, Source={x:Reference ImgBtn}}"
                FontSize="16"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"/>
        </StackLayout>
    </Frame>
</ContentView>
