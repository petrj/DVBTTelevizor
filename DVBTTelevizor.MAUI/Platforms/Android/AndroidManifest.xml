<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="net.petrjanousek.DVBTTelevizor" >
    <!-- Declare package visibility for Android 11+ so GetApplicationInfo/GetLaunchIntentForPackage can detect these apps -->
    <queries>
        <package android:name="marto.rtl_tcp_andro" />
        <package android:name="info.martinmarinov.dvbdriver" />
    </queries>

    <application 
		android:allowBackup="true" 
		android:supportsRtl="true" 
		android:label="DVBT Televizor" 
		android:icon="@mipmap/appicon"
		android:banner="@drawable/banner">
	</application>
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
	<uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
	<meta-data android:name="com.google.android.play.billingclient.version" android:value="10.0.0" />

</manifest>