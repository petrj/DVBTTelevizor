<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DVBTTelevizor.MAUI.EPGPage"
             xmlns:local="clr-namespace:DVBTTelevizor.MAUI"
             xmlns:converters="clr-namespace:DVBTTelevizor.MAUI.Converters"
             BackgroundColor="Black">

    <NavigationPage.TitleView>
        <HorizontalStackLayout
            Spacing="8"
            VerticalOptions="Center"
            HorizontalOptions="Start">
            <Image
                Source="{Binding Channel.Icon}"
                HeightRequest="24"
                WidthRequest="24"
                Aspect="AspectFit"
                VerticalOptions="Center" />
            <Label
                Text="{Binding Channel.Name}"
                TextColor="White"
                FontSize="18"
                VerticalTextAlignment="Center"
                VerticalOptions="Center" />
        </HorizontalStackLayout>
    </NavigationPage.TitleView>

    <ContentPage.Resources>
        <ResourceDictionary>

            <converters:SelectionColorConverter x:Key="SelectionColorConverter" />
            <converters:SelectionVisibilityConverter x:Key="SelectionVisibilityConverter" />

            <Style x:Key="CaptionStyle" TargetType="Label">
                <Setter Property="TextColor" Value="#41b3ff"/>
            </Style>

            <Style x:Key="ButtonStyle" TargetType="Button">
                <Setter Property="Margin" Value="30,20,20,20"/>
                <Setter Property="FontAttributes" Value="Bold"/>

                <Setter Property="Padding" Value="0,0,0,0"/>
                <Setter Property="BorderWidth" Value="0" />
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="BackgroundColor" Value="Gray"/>
                <Setter Property="CornerRadius" Value="20"/>
            </Style>

            <Style x:Key="CollectionViewStyle" TargetType="CollectionView">
                <Setter Property="BackgroundColor" Value="Black"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
            </Style>

            <Style x:Key="LabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="HorizontalTextAlignment" Value="Center"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
                <Setter Property="VerticalOptions" Value="FillAndExpand" />
                <Setter Property="HorizontalOptions" Value="FillAndExpand" />
            </Style>


            <Style x:Key="TimeTextStyle" TargetType="Label">
                <Setter Property="TextColor" Value="SpringGreen"/>
                <Setter Property="VerticalTextAlignment" Value="Start"/>
                <Setter Property="HorizontalOptions" Value="Start"/>
                <Setter Property="FontAttributes" Value="None"/>
                <Setter Property="LineBreakMode" Value="NoWrap"/>
                <Setter Property="Margin" Value="5,0,5,0"/>
                <Setter Property="Padding" Value="0,0,0,0"/>
            </Style>


            <Style x:Key="EPGTitleTextStyle" TargetType="Label">
                <!--Setter Property="TextColor" Value="#41b3ff"/-->
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="VerticalTextAlignment" Value="Start"/>
                <Setter Property="MaxLines" Value="2"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
                <Setter Property="Padding" Value="0,0,0,0"/>
                <Setter Property="TextColor" Value="#41b3ff"/>
            </Style>

            <Style x:Key="EPGTextStyle" TargetType="Label">
                <!--Setter Property="TextColor" Value="#41b3ff"/-->
                <Setter Property="VerticalTextAlignment" Value="Start"/>
                <Setter Property="FontAttributes" Value="Italic"/>
                <Setter Property="MaxLines" Value="1"/>
                <Setter Property="Margin" Value="15,0,0,0"/>
                <Setter Property="Padding" Value="0,0,0,0"/>
                <Setter Property="TextColor" Value="White"/>
            </Style>

            <Style x:Key="ProgressStyle" TargetType="ProgressBar">
                <Setter Property="BackgroundColor" Value="#222222"/>
                <Setter Property="ProgressColor" Value="White"/>
            </Style>

            <Style x:Key="TimeFromTextStyle" TargetType="Label">
                <Setter Property="TextColor" Value="SpringGreen"/>
                <Setter Property="VerticalTextAlignment" Value="Start"/>
                <Setter Property="HorizontalOptions" Value="Start"/>
                <Setter Property="FontAttributes" Value="None"/>
                <Setter Property="LineBreakMode" Value="NoWrap"/>
                <Setter Property="Margin" Value="5,0,5,0"/>
                <Setter Property="Padding" Value="0,0,0,0"/>
            </Style>

            <Style x:Key="TimeToTextStyle" TargetType="Label">
                <Setter Property="TextColor" Value="SpringGreen"/>
                <Setter Property="VerticalTextAlignment" Value="Start"/>
                <Setter Property="HorizontalOptions" Value="End"/>
                <Setter Property="FontAttributes" Value="None"/>
                <Setter Property="LineBreakMode" Value="NoWrap"/>
                <Setter Property="Margin" Value="5,0,5,0"/>
                <Setter Property="Padding" Value="0,0,0,0"/>
            </Style>

            <Style x:Key="DescriptionTextStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="Margin" Value="0,0,0,0"/>
                <Setter Property="Padding" Value="5,5,5,5"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
            </Style>

        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem IconImageSource="left.png" x:Name="LeftToolbarItem"
                 Clicked="Icon_Clicked" />
        <ToolbarItem IconImageSource="right.png" x:Name="RightToolbarItem"
                 Clicked="Icon_Clicked" />
    </ContentPage.ToolbarItems>

    <AbsoluteLayout BackgroundColor="Black">

        <RefreshView
               x:Name="EPGRefreshView"
               AbsoluteLayout.LayoutBounds="0.0, 0.0, 0.5, 1.0"
               AbsoluteLayout.LayoutFlags="All"
               Command="{Binding RefreshCommand}"
               IsRefreshing="{Binding IsRefreshing}">

            <CollectionView
                   x:Name="EPGListView"
                   ItemsSource="{Binding EventItems}"
                   SelectedItem="{Binding SelectedItem}"
                   Style="{StaticResource CollectionViewStyle}"
                   SelectionChangedCommand="{Binding SelectionChangedCommand}"
                   SelectionChangedCommandParameter="{Binding SelectedItem}"
                   SelectionMode="Single">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid RowSpacing="0" Padding="0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="1" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20*" />
                                <ColumnDefinition Width="80*" />
                            </Grid.ColumnDefinitions>

                            <Grid.BackgroundColor>
                                <MultiBinding Converter="{StaticResource SelectionColorConverter}">
                                    <Binding Path="." />
                                    <Binding Path="BindingContext.SelectedItem" Source="{RelativeSource AncestorType={x:Type ContentPage}}" />
                                </MultiBinding>
                            </Grid.BackgroundColor>

                            <Label Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="2" Text="{Binding TimeDescription}" Style="{DynamicResource TimeTextStyle}"  FontSize="{Binding FontSizeForCaption}" />
                            <Label Grid.Row="1" Grid.Column="1"  Text="{Binding EventName}" Style="{DynamicResource EPGTitleTextStyle}" FontSize="{Binding FontSizeForCaption}"/>
                            <Label Grid.Row="2" Grid.Column="1"  Text="{Binding Text}" Style="{DynamicResource EPGTextStyle}" FontSize="{Binding FontSizeForLabel}"/>

                            <ProgressBar Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Progress="{Binding Progress}" Style="{DynamicResource ProgressStyle}">
                                <ProgressBar.IsVisible>
                                    <MultiBinding Converter="{StaticResource SelectionVisibilityConverter}">
                                        <Binding Path="." />
                                        <Binding Path="BindingContext.SelectedItem" Source="{RelativeSource AncestorType={x:Type ContentPage}}" />
                                    </MultiBinding>
                                </ProgressBar.IsVisible>
                            </ProgressBar>

                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </RefreshView>

        <Grid
            x:Name="EPGDetailGrid"
            BindingContext="{Binding SelectedItem}"
            AbsoluteLayout.LayoutBounds="1.0, 1.0, 1.0, 0.5"
            AbsoluteLayout.LayoutFlags="All"
            BackgroundColor="#262626"
            Margin="0,0,0,0"
            Padding="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="60*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="50*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>

            <BoxView Grid.Row="0" Grid.Column="0"  Grid.ColumnSpan="3" x:Name="EventNameLabel" />

            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding EventName}" Style="{DynamicResource EPGTitleTextStyle}" FontSize="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}}, Path=BindingContext.FontSizeForEPGTitle}" Margin="5,5,5,5"/>

            <Label Grid.Row="1" Grid.Column="0"  Text="{Binding StartTime, StringFormat='{}{0:HH:mm}'}"  Style="{DynamicResource TimeFromTextStyle}" />
            <Label Grid.Row="1" Grid.Column="2"  Text="{Binding FinishTime, StringFormat='{}{0:HH:mm}'}"  Style="{DynamicResource TimeToTextStyle}" />

            <Grid Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" x:Name="ProgresssBarGrid" BackgroundColor="Aqua" VerticalOptions="CenterAndExpand">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ProgressBar Grid.Row="0" Grid.Column="0" Progress="{Binding Progress}" Style="{DynamicResource ProgressStyle}" />
            </Grid>

            <ScrollView x:Name="SelectedChannelEPGDescriptionScrollView" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" BackgroundColor="Black" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand" Margin="5,5,5,5" VerticalScrollBarVisibility="Always" >
                    <Label x:Name="LabelChannelEPGDescription" Text="{Binding Text}"  Style="{DynamicResource DescriptionTextStyle}" VerticalOptions="StartAndExpand" HorizontalOptions="FillAndExpand"/>
            </ScrollView>

        </Grid>

    </AbsoluteLayout>

</ContentPage>