<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:DVBTTelevizor.MAUI"
             x:Class="DVBTTelevizor.MAUI.SettingsPage"
             BackgroundColor="Black"
             Title="{local:LngXamlExt Input='Settings'}">

    <ContentPage.Resources>
        <ResourceDictionary>

            <Style x:Key="LabelStyle" TargetType="Label">
                <!--Setter Property="TextColor" Value="#41b3ff"/-->
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="HorizontalTextAlignment" Value="Start"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
            </Style>

            <Style x:Key="YellowLabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="yellow"/>
                <Setter Property="HorizontalTextAlignment" Value="Start"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,10,1,0" />
            </Style>

            <Style x:Key="DetailLabelStyle" TargetType="Label">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="HorizontalTextAlignment" Value="Start"/>
                <Setter Property="VerticalTextAlignment" Value="Start"/>
                <Setter Property="Margin" Value="20,10,20,0"/>
            </Style>

            <Style x:Key="CaptionStyle" TargetType="Label">
                <Setter Property="TextColor" Value="#41b3ff"/>
            </Style>

            <Style x:Key="SwitchStyle" TargetType="Switch">
                <Setter Property="HorizontalOptions" Value="End"/>
                <Setter Property="VerticalOptions" Value="Center"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="Margin" Value="10,0,10,0"/>
                <Setter Property="ThumbColor" Value="Blue"/>
                <Setter Property="OnColor" Value="CornflowerBlue"/>
            </Style>

            <Style x:Key="ButtonStyle" TargetType="Button">
                <Setter Property="Margin" Value="10,10,5,0"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="Padding" Value="0,0,0,0"/>
                <Setter Property="BorderWidth" Value="0"/>
                <Setter Property="CornerRadius" Value="7"/>
                <Setter Property="BackgroundColor" Value="Gray"/>
                <Setter Property="CornerRadius" Value="20"/>
            </Style>

            <Style x:Key="CommonPickerTextStyle" TargetType="Picker">
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="BackgroundColor" Value="Black"/>
                <Setter Property="HorizontalTextAlignment" Value="End"/>
                <Setter Property="Margin" Value="3,3,3,3"/>
            </Style>

            <Style x:Key="BoxViewStyle" TargetType="BoxView">
                <Setter Property="CornerRadius" Value="15"/>
                <Setter Property="BackgroundColor" Value="#333333"/>
                <Setter Property="Margin" Value="3,3,3,3"/>
            </Style>

            <Style x:Key="CommonSwitchTextStyle" TargetType="Switch">
                <Setter Property="HorizontalOptions" Value="End"/>
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="Margin" Value="0,0,20,0"/>
                <Setter Property="FlowDirection" Value="LeftToRight"/>
                <Setter Property="ThumbColor" Value="Blue"/>
                <Setter Property="OnColor" Value="CornflowerBlue"/>
            </Style>

            <Style x:Key="EntryStyle" TargetType="Entry">
                <Setter Property="TextColor" Value="Yellow"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
                <Setter Property="HorizontalTextAlignment" Value="End"/>
                <Setter Property="PlaceholderColor" Value="Gray"/>
                <Setter Property="BackgroundColor" Value="#222222"/>
                <Setter Property="HorizontalOptions" Value="FillAndExpand"/>
                <Setter Property="Margin" Value="3,3,3,3"/>
            </Style>

            <Style x:Key="LinkStyle" TargetType="Label">
                <Setter Property="TextColor" Value="#41b3ff"/>
                <Setter Property="VerticalTextAlignment" Value="Center"/>
                <Setter Property="HorizontalTextAlignment" Value="Start"/>
            </Style>

            <Style x:Key="SeparatorBoxViewStyle" TargetType="BoxView">
                <Setter Property="VerticalOptions" Value="FillAndExpand"/>
                <Setter Property="HorizontalOptions" Value="FillAndExpand"/>
                <Setter Property="HeightRequest" Value="1"/>
                <Setter Property="Color" Value="Gray"/>
            </Style>

        </ResourceDictionary>

    </ContentPage.Resources>

    <AbsoluteLayout x:Name="SettingsAbsoluteLayout" BackgroundColor="Black" Margin="0,0,0,0">

        <ScrollView AbsoluteLayout.LayoutBounds="0.0, 0.0, 1.0, 1.0" AbsoluteLayout.LayoutFlags="All" x:Name="SettingsScrollView" Margin="10,10,10,0" HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

            <StackLayout HorizontalOptions="FillAndExpand" VerticalOptions="FillAndExpand">

                <StackLayout Margin="0,0,0,10">

                    <Label Text="{local:LngXamlExt Input='Channels list'}" Style="{DynamicResource CaptionStyle}" FontSize="{Binding FontSizeForCaption}"/>

                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="33*" />
                            <ColumnDefinition Width="33*" />
                            <ColumnDefinition Width="33*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Row="0" Grid.Column="0" x:Name="ExportToFileButton" Text="{local:LngXamlExt Input='Export'}"  Clicked="ExportToFileButton_Clicked" Style="{DynamicResource ButtonStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <Button Grid.Row="0" Grid.Column="1" x:Name="ImportChannelsButton" Text="{local:LngXamlExt Input='Import'}"  Clicked="ImportChannelsButton_Clicked" Style="{DynamicResource ButtonStyle}" FontSize="{Binding FontSizeForLabel}"/>
                        <Button Grid.Row="0" Grid.Column="2" x:Name="ClearChannelsButton" Text="{local:LngXamlExt Input='Delete'}" Style="{DynamicResource ButtonStyle}" FontSize="{Binding FontSizeForLabel}" Clicked="ClearChannelsButton_Clicked"/>

                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding AndroidChannelsListPath}" Style="{DynamicResource DetailLabelStyle}" FontSize="{Binding FontSizeForDetailNote}" HorizontalTextAlignment="End" />

                    </Grid>

                </StackLayout>

                <BoxView Style="{DynamicResource SeparatorBoxViewStyle}" ></BoxView>

                <StackLayout Margin="0,10,0,0">

                    <Label Text="{local:LngXamlExt Input='System settings'}" Style="{DynamicResource CaptionStyle}" FontSize="{Binding FontSizeForCaption}"/>

                    <Grid Margin="30,10,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="ShowFullScreenBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label  Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Full screen'}" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}"/>

                        <BoxView Grid.Row="0" Grid.Column="1" Style="{StaticResource BoxViewStyle}"/>
                        <Switch Grid.Row="0" Grid.Column="1" x:Name="FullscreenSwitch"  IsToggled="{Binding Config.Fullscreen, Mode=TwoWay}" Style="{StaticResource CommonSwitchTextStyle}"/>



                        <BoxView x:Name="ShowPlayOnBackgroundBoxView" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label  Grid.Row="1" Grid.Column="0" Text="{local:LngXamlExt Input='Play on background'}" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}"/>

                        <BoxView Grid.Row="1" Grid.Column="1" Style="{StaticResource BoxViewStyle}" />
                        <Switch Grid.Row="1" Grid.Column="1" x:Name="PlayOnBackgroundSwitch"  IsToggled="{Binding Config.PlayOnBackground, Mode=TwoWay}" Style="{StaticResource CommonSwitchTextStyle}" />

                    </Grid>

                    <Grid Margin="30,0,10,0" BackgroundColor="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="FontSizeBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Font size'}" x:Name="FontSizeLabel" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <Picker
                                Grid.Row="0" Grid.Column="1"
                                x:Name="FontSizePicker"
                                FontSize="{Binding FontSizeForPicker}"
                                Style="{StaticResource CommonPickerTextStyle}"
                                ItemsSource="{Binding FontSizes}"
                                SelectedIndex="{Binding AppFontSizeIndex, Mode=TwoWay}">
                        </Picker>
                    </Grid>

                    <Grid Margin="30,0,10,0" RowSpacing="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="AutoStartBoxView" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Startup auto play'}" x:Name="AutoStartLabel" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <Picker
                                Grid.Row="1" Grid.Column="0"
                                x:Name="ChannelAutoPlayedAfterStartPicker"
                                FontSize="{Binding FontSizeForPicker}"
                                Style="{StaticResource CommonPickerTextStyle}"
                                SelectedItem="{Binding SelectedChannel, Mode=TwoWay}"
                                ItemsSource="{Binding AutoPlayChannels}"
                                ItemDisplayBinding="{Binding NameWithNumber}"/>
                    </Grid>

                    <Grid Margin="30,0,10,0" >
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="EnableRTLSDRBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label  Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Enable SDR'}" Style="{DynamicResource LabelStyle}" FontSize="{Binding FontSizeForLabel}"/>
                        <BoxView Grid.Row="0" Grid.Column="1" Style="{StaticResource BoxViewStyle}"/>
                        <Switch Grid.Row="0" Grid.Column="1" x:Name="EnableRTLSDRSwitch"  IsToggled="{Binding Config.RTLSDREnabled, Mode=TwoWay}"  Style="{StaticResource CommonSwitchTextStyle}"/>
                        <Label  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{local:LngXamlExt Input='(FM radio is experimental function and requires SDR driver)'}" Style="{DynamicResource DetailLabelStyle}" FontSize="{Binding FontSizeForDetailNote}" HorizontalOptions="End"/>

                    </Grid>

                </StackLayout>

                <StackLayout Margin="0,0,0,10">

                    <Button x:Name="ClearEPGButton" Text="{local:LngXamlExt Input='CLEAR CACHE'}" Clicked="ClearEPGButton_Clicked" Style="{DynamicResource ButtonStyle}" FontSize="{Binding FontSizeForLabel}"/>

                </StackLayout>

                <BoxView Style="{DynamicResource SeparatorBoxViewStyle}" ></BoxView>

                <StackLayout Margin="0,10,0,10">

                    <Label Text="{local:LngXamlExt Input='Remote accesss'}" Style="{DynamicResource CaptionStyle}" FontSize="{Binding FontSizeForCaption}"/>

                    <Grid Margin="30,10,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="RemoteAccessEnabledBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>
                        <Label Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Enabled'}" Style="{DynamicResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <BoxView Grid.Row="0" Grid.Column="1" Style="{StaticResource BoxViewStyle}"/>
                        <Switch Grid.Row="0" Grid.Column="1" x:Name="RemoteAccessSwitch" IsToggled="{Binding AllowRemoteAccessService, Mode=TwoWay}" Style="{StaticResource CommonSwitchTextStyle}" />
                    </Grid>

                    <StackLayout IsVisible="{Binding Config.AllowRemoteAccessService}">

                        <Grid Margin="30,10,30,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100*" />
                            </Grid.ColumnDefinitions>

                            <BoxView x:Name="RemoteAccessIPBoxView" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>
                            <Label  Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='IP'}" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                            <Entry  Grid.Row="1" Grid.Column="0" x:Name="IPEntry" Text="{Binding Config.RemoteAccessServiceIP, Mode=TwoWay}" Style="{StaticResource EntryStyle}" Keyboard="Url" />

                            <BoxView x:Name="RemoteAccessPortBoxView" Grid.Row="2" Grid.Column="0" Grid.RowSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>
                            <Label  Grid.Row="2" Grid.Column="0" Text="{local:LngXamlExt Input='Port'}" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                            <Entry  Grid.Row="3" Grid.Column="0" x:Name="PortEntry" Text="{Binding Config.RemoteAccessServicePort, Mode=TwoWay}" Style="{StaticResource EntryStyle}" Keyboard="Numeric" />

                            <BoxView x:Name="RemoteAccessSecurityKeyBoxView" Grid.Row="4" Grid.Column="0" Grid.RowSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>
                            <Label  Grid.Row="4" Grid.Column="0" Text="{local:LngXamlExt Input='Security key'}" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}"/>
                            <Entry Grid.Row="5" Grid.Column="0"  x:Name="SecurityKeyEntry" Text="{Binding Config.RemoteAccessServiceSecurityKey, Mode=TwoWay}" Style="{StaticResource EntryStyle}" />

                            <Grid Grid.Row="6" Grid.Column="0" HorizontalOptions="End">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>

                                <Image Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Source="RemoteTelevizor" Aspect="AspectFit" VerticalOptions="Start" HorizontalOptions="Center">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRemoteTelevizorLabelTapped" NumberOfTapsRequired="1" />
                                    </Image.GestureRecognizers>
                                </Image>
                                <Label Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='For remote access use application:'}" Style="{StaticResource DetailLabelStyle}" FontSize="{Binding FontSizeForDetailNote}"/>

                                <BoxView x:Name="RemoteAccessAppLinkBoxView" Grid.Row="0" Grid.Column="1" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="Remote Televizor" Style="{StaticResource LinkStyle}" FontSize="{Binding FontSizeForDetailNote}" >
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnRemoteTelevizorLabelTapped" NumberOfTapsRequired="1" />
                                    </Label.GestureRecognizers>
                                </Label>

                            </Grid>
                        </Grid>

                    </StackLayout>

                </StackLayout>

                <BoxView Style="{DynamicResource SeparatorBoxViewStyle}" IsVisible="{Binding DebugSettingsVisible}"/>

                <StackLayout Margin="0,10,0,10">

                    <Label Text="{local:LngXamlExt Input='Recording'}" Style="{DynamicResource CaptionStyle}" FontSize="{Binding FontSizeForCaption}"/>

                    <Grid Margin="30,10,10,0" BackgroundColor="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="RecordingBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Text="{local:LngXamlExt Input='Recording directory'}" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding Config.OutputDirectory}"  Style="{StaticResource YellowLabelStyle}" FontSize="{Binding FontSizeForLabel}" HorizontalOptions="End" Margin="0,5,0,5" />

                        <BoxView x:Name="WriteToExternalDeviceSwitchBoxView" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="{local:LngXamlExt Input='Write to external storage'}" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <BoxView Grid.Row="2" Grid.Column="1" Style="{StaticResource BoxViewStyle}"/>
                        <Switch Grid.Row="2" Grid.Column="1" x:Name="WriteToExternalDeviceSwitch" IsToggled="{Binding Config.WriteToExternalDevice, Mode=TwoWay}" Style="{StaticResource CommonSwitchTextStyle}"/>
                    </Grid>

                </StackLayout>


                <BoxView Style="{DynamicResource SeparatorBoxViewStyle}" ></BoxView>

                <StackLayout Margin="0,10,0,10">

                    <Label Text="{local:LngXamlExt Input='Language'}" Style="{DynamicResource CaptionStyle}" FontSize="{Binding FontSizeForCaption}"/>

                    <Grid Margin="30,5,10,0" BackgroundColor="Transparent">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30*" />
                            <ColumnDefinition Width="70*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="LanguageBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Application language'}" x:Name="LanguageLabel" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <Picker
                                Grid.Row="0" Grid.Column="1"
                                x:Name="LanguagePicker"
                                FontSize="{Binding FontSizeForPicker}"
                                Style="{StaticResource CommonPickerTextStyle}"
                                ItemsSource="{Binding Languages}"
                                SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}">
                        </Picker>
                    </Grid>

                </StackLayout>

                <BoxView Style="{DynamicResource SeparatorBoxViewStyle}" ></BoxView>

                <StackLayout Margin="0,10,0,10" x:Name="StackLayoutLogging">

                    <Label Text="{local:LngXamlExt Input='Logging'}" Style="{DynamicResource CaptionStyle}" FontSize="{Binding FontSizeForCaption}"/>

                    <Grid Margin="30,10,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="EnableLoggingBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label  Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Enable logging'}" Style="{DynamicResource LabelStyle}" FontSize="{Binding FontSizeForLabel}"/>
                        <BoxView Grid.Row="0" Grid.Column="1" Style="{StaticResource BoxViewStyle}"/>
                        <Switch Grid.Row="0" Grid.Column="1" x:Name="EnableLoggingSwitch"  IsToggled="{Binding Config.EnableLogging, Mode=TwoWay}"  Style="{StaticResource CommonSwitchTextStyle}"/>

                        <Label  Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="/storage/emulated/0/Android/media/net.petrjanousek.DVBTTelevizor/DVBTTelevizor.log" Style="{DynamicResource DetailLabelStyle}" FontSize="{Binding FontSizeForDetailNote}" IsVisible="{Binding EnableLogging}"/>
                    </Grid>

                    <Grid Margin="30,10,10,0" IsVisible="{Binding DebugSettingsVisible}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="UDPIPLoggingBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label  Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='UDP IP'}" Style="{DynamicResource LabelStyle}" FontSize="{Binding FontSizeForLabel}"/>
                        <Entry Grid.Row="0" Grid.Column="1" x:Name="UDPIPEntry"  Text="{Binding Config.LoggingUDPIP, Mode=TwoWay}"  Style="{StaticResource EntryStyle}" FontSize="{Binding FontSizeForLabel}"/>

                    </Grid>

                </StackLayout>

                <BoxView Style="{DynamicResource SeparatorBoxViewStyle}" ></BoxView>

                <StackLayout Margin="0,10,0,10" x:Name="StackLayoutDebugDrivers" IsVisible="{Binding DebugSettingsVisible}">

                    <Label Text="{local:LngXamlExt Input='Debug drivers'}" Style="{DynamicResource CaptionStyle}" FontSize="{Binding FontSizeForCaption}"/>

                    <Grid Margin="30,10,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="DebugDriversBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label  Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Debug drivers'}" Style="{DynamicResource LabelStyle}" FontSize="{Binding FontSizeForLabel}"/>
                        <BoxView Grid.Row="0" Grid.Column="1" Style="{StaticResource BoxViewStyle}"/>
                        <Switch Grid.Row="0" Grid.Column="1" x:Name="DebugDriversSwitch"  IsToggled="{Binding Config.TestingMode, Mode=TwoWay}"  Style="{StaticResource CommonSwitchTextStyle}"/>
                    </Grid>

                </StackLayout>

                <BoxView Style="{DynamicResource SeparatorBoxViewStyle}" ></BoxView>

                <StackLayout Margin="0,10,0,10" x:Name="StackLayoutRemoteSDR">

                    <Label Text="{local:LngXamlExt Input='Remote SDR'}" Style="{DynamicResource CaptionStyle}" FontSize="{Binding FontSizeForCaption}"/>

                    <Grid Margin="30,10,10,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="RemoteSDRBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label  Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Allow remote SDR via rtl_tcp'}" Style="{DynamicResource LabelStyle}" FontSize="{Binding FontSizeForLabel}"/>
                        <BoxView Grid.Row="0" Grid.Column="1" Style="{StaticResource BoxViewStyle}"/>
                        <Switch Grid.Row="0" Grid.Column="1" x:Name="RemoteSDRSwitch"  IsToggled="{Binding AllowRemoteSDR, Mode=TwoWay}"  Style="{StaticResource CommonSwitchTextStyle}"/>
                    </Grid>

                    <Grid Margin="60,10,10,0" IsVisible="{Binding AllowRemoteSDR}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="RemoteSDRIPBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label  Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='IP'}" Style="{DynamicResource LabelStyle}" FontSize="{Binding FontSizeForLabel}"/>
                        <Entry Grid.Row="0" Grid.Column="1" x:Name="RemoteSDRIPEntry"  Text="{Binding Config.RemoteSDRIP, Mode=TwoWay}"  Style="{StaticResource EntryStyle}" FontSize="{Binding FontSizeForLabel}"/>

                        <BoxView x:Name="RemoteSDRPortBoxView" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>

                        <Label  Grid.Row="1" Grid.Column="0" Text="{local:LngXamlExt Input='Port'}" Style="{DynamicResource LabelStyle}" FontSize="{Binding FontSizeForLabel}"/>
                        <Entry Grid.Row="1" Grid.Column="1" x:Name="RemoteSDRportEntry"  Text="{Binding Config.RemoteSDRPort, Mode=TwoWay}"  Style="{StaticResource EntryStyle}" FontSize="{Binding FontSizeForLabel}" Keyboard="Numeric"/>
                    </Grid>

                </StackLayout>

                <BoxView Style="{DynamicResource SeparatorBoxViewStyle}" ></BoxView>

                <StackLayout Margin="0,10,0,10" x:Name="StackLayoutSledovaniTV">
                    <Label Text="{local:LngXamlExt Input='SledovaniTV'}" Style="{DynamicResource CaptionStyle}" FontSize="{Binding FontSizeForCaption}"/>

                    <Label Text="{local:LngXamlExt Input='SledovaniTV is czech IPTV. You must have an existing account and you must be connected to Internet'}" Style="{DynamicResource DetailLabelStyle}" FontSize="{Binding FontSizeForLabel}"/>

                </StackLayout>

                <Grid Margin="30,10,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70*" />
                        <ColumnDefinition Width="30*" />
                    </Grid.ColumnDefinitions>

                    <BoxView x:Name="SledovaniTVEnabledBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" Margin="-5,-5,-5,-5"/>
                    <Label Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Enabled'}" Style="{DynamicResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                    <BoxView Grid.Row="0" Grid.Column="1" Style="{StaticResource BoxViewStyle}"/>
                    <Switch Grid.Row="0" Grid.Column="1" x:Name="SledovaniTVSwitch" IsToggled="{Binding SledovaniTVEnabled, Mode=TwoWay}" Style="{StaticResource CommonSwitchTextStyle}" />
                </Grid>

                <StackLayout IsVisible="{Binding Config.SledovaniTVEnabled}">

                    <Grid Margin="60,10,30,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="SledovaniTVUserNameBoxView" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BackgroundColor="Transparent" IsVisible="{Binding Config.SledovaniTVEnabled}" Margin="-5,-5,-5,-5" />
                        <Label  Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Username'}" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <Entry  Grid.Row="1" Grid.Column="0" x:Name="SledovaniTVUserNameEntry" Text="{Binding Config.SledovaniTVUserName, Mode=TwoWay}" Style="{StaticResource EntryStyle}" Keyboard="Url" />

                        <BoxView x:Name="SledovaniTVPasswordBoxView" Grid.Row="2" Grid.Column="0" Grid.RowSpan="2" BackgroundColor="Transparent" IsVisible="{Binding Config.SledovaniTVEnabled}" Margin="-5,-5,-5,-5"/>
                        <Label  Grid.Row="2" Grid.Column="0" Text="{local:LngXamlExt Input='Password'}" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <Entry  Grid.Row="3" Grid.Column="0" x:Name="SledovaniTVPasswordEntry" Text="{Binding Config.SledovaniTVPassword, Mode=TwoWay}" Style="{StaticResource EntryStyle}" />

                    </Grid>

                    <Button Margin="60,10,0,0" x:Name="SledovaniTVPairButton" IsVisible="{Binding SledovaniTVDeviceNotPaired}" Text="{local:LngXamlExt Input='Pair device'}" Style="{DynamicResource ButtonStyle}" FontSize="{Binding FontSizeForLabel}" Clicked="SledovaniTVPairButton_Clicked"/>
                    <Button Margin="60,10,0,0" x:Name="SledovaniTVReloadChannelsButton" IsVisible="{Binding SledovaniTVDevicePaired}" Text="{local:LngXamlExt Input='Reload channels'}" Style="{DynamicResource ButtonStyle}" FontSize="{Binding FontSizeForLabel}" Clicked="SledovaniTVReloadChannelsButton_Clicked"/>

                    <Grid Margin="60,10,10,0" IsVisible="{Binding SledovaniTVDevicePaired}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="SledovaniTVShowDeviceBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" IsVisible="{Binding SledovaniTVDevicePaired}"/>
                        <Label Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Show paired device info'}" Style="{DynamicResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <BoxView Grid.Row="0" Grid.Column="1" Style="{StaticResource BoxViewStyle}"/>
                        <Switch Grid.Row="0" Grid.Column="1" x:Name="SledovaniTVShowPairedDeviceSwitch" IsToggled="{Binding SledovaniTVShowPairedDevice, Mode=TwoWay}" Style="{StaticResource CommonSwitchTextStyle}" />
                    </Grid>

                    <Grid Margin="120,10,30,0" IsVisible="{Binding SledovaniTVShowPairedDevice}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="SledovaniTVDeviceIDBoxView" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BackgroundColor="Transparent" IsVisible="{Binding SledovaniTVDevicePaired}"/>
                        <Label  Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Device ID'}" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <Entry  Grid.Row="1" Grid.Column="0" x:Name="SledovaniTVDeviceIDEntry" Text="{Binding Config.SledovaniTVDeviceID, Mode=TwoWay}" Style="{StaticResource EntryStyle}" Keyboard="Url" />

                        <BoxView x:Name="SledovaniTVDevicePasswordBoxView" Grid.Row="2" Grid.Column="0" Grid.RowSpan="2" BackgroundColor="Transparent" IsVisible="{Binding SledovaniTVDevicePaired}"/>
                        <Label  Grid.Row="2" Grid.Column="0" Text="{local:LngXamlExt Input='Device password'}" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <Entry  Grid.Row="3" Grid.Column="0" x:Name="SledovaniTVDevicePasswordEntry" Text="{Binding Config.SledovaniTVDevicePassword, Mode=TwoWay}" Style="{StaticResource EntryStyle}"  />

                    </Grid>


                    <Grid Margin="60,10,10,0" IsVisible="{Binding SledovaniTVDevicePaired}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70*" />
                            <ColumnDefinition Width="30*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="SledovaniTVShowAdultChannelsBoxView" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" BackgroundColor="Transparent" IsVisible="{Binding SledovaniTVDevicePaired}" Margin="-5,-5,-5,-5"/>
                        <Label Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='Show adult channels'}" Style="{DynamicResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <BoxView Grid.Row="0" Grid.Column="1" Style="{StaticResource BoxViewStyle}"/>
                        <Switch Grid.Row="0" Grid.Column="1" x:Name="SledovaniTVShowAdultChannelsSwitch" IsToggled="{Binding SledovaniTVShowAdultChannels, Mode=TwoWay}" Style="{StaticResource CommonSwitchTextStyle}" />
                    </Grid>

                    <Grid Margin="120,10,30,0" IsVisible="{Binding SledovaniTVShowAdultChannels}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto" />
                            <RowDefinition Height="auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100*" />
                        </Grid.ColumnDefinitions>

                        <BoxView x:Name="SledovaniTVPINBoxView" Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" BackgroundColor="Transparent" IsVisible="{Binding SledovaniTVShowAdultChannels}" Margin="-5,-5,-5,-5"/>
                        <Label  Grid.Row="0" Grid.Column="0" Text="{local:LngXamlExt Input='PIN'}" Style="{StaticResource LabelStyle}" FontSize="{Binding FontSizeForLabel}" />
                        <Entry  Grid.Row="1" Grid.Column="0" x:Name="SledovaniTVPINEntry" Text="{Binding Config.SledovaniTVPIN, Mode=TwoWay}" Style="{StaticResource EntryStyle}" Keyboard="Url" />

                    </Grid>


                </StackLayout>

                <BoxView Style="{DynamicResource SeparatorBoxViewStyle}" Margin="0,30,0,0"></BoxView>



                <BoxView Style="{DynamicResource SeparatorBoxViewStyle}" ></BoxView>

                <Grid Margin="0,10,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50*" />
                        <ColumnDefinition Width="50*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" x:Name="ExportSettingsToFileButton" Text="{local:LngXamlExt Input='Export settings'}"  Clicked="ExportSettingsToFileButton_Clicked" Style="{DynamicResource ButtonStyle}" FontSize="{Binding FontSizeForLabel}" />
                    <Button Grid.Row="0" Grid.Column="1" x:Name="ImportSettingsFromFileButton" Text="{local:LngXamlExt Input='Import settings'}"  Clicked="ImportSettingsFromFileButton_Clicked" Style="{DynamicResource ButtonStyle}" FontSize="{Binding FontSizeForLabel}"/>

                    <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding AndroidSettingsListPath}" Style="{DynamicResource DetailLabelStyle}" FontSize="{Binding FontSizeForDetailNote}" HorizontalTextAlignment="End" />

                </Grid>

                <BoxView Style="{DynamicResource SeparatorBoxViewStyle}" ></BoxView>

            </StackLayout>

        </ScrollView>

        <local:Menu x:Name="MainMenu"  Tapped="Menu_Tapped" AbsoluteLayout.LayoutFlags="All" AbsoluteLayout.LayoutBounds="0.5,0.5,0.75,0.75" IsVisible="{Binding MenuVisible}" />

    </AbsoluteLayout>

</ContentPage>